# Connection string do PostgreSQL (aponta para o banco do docker-compose)
DATABASE_URL=postgresql+asyncpg://app:app123@localhost:5432/my_agent_app

# Chave de API da Anthropic (obrigatoria apenas quando usar agentes)
ANTHROPIC_API_KEY=

# Modelo usado pelos agentes LangChain (formato provider:modelo)
LLM_MODEL=anthropic:claude-sonnet-5
